# Server
NODE_ENV=development
PORT=3000

# Public site URL (email verification / password reset links). Use your Cloudflare Workers or custom domain, e.g. https://sellitnow.your-subdomain.workers.dev
API_BASE_URL=http://localhost:3000
# Comma-separated frontend origins allowed by CORS in production
# CORS_ALLOWED_ORIGINS=https://sellitnow.example.com,https://admin.sellitnow.example.com

# Behind Cloudflare Worker proxy + host (e.g. Render): hop count for Express. Default 1. Try 2 if req.ip is wrong.
# TRUST_PROXY=1

# Cloudflare: Worker variable API_ORIGIN = this Node app’s HTTPS origin (Render/Railway/Fly). Also accepted: UPSTREAM_ORIGIN or SELLITNOW_API.
# If /api/* returns 503: open https://<worker>/cf-worker-ping — if api_origin_configured is false, add API_ORIGIN in the dashboard.
# If true, open API_ORIGIN/health in a browser; 503 usually means the host is down, sleeping (free tier), or the app crashed on boot.

# Database
# Leave unset to use SQLite (default: <STORAGE_ROOT>/data/sellitnow.db).
# Set to your Render Postgres "Internal Database URL" (or external URL with sslmode=require) to use PostgreSQL.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# SQLITE_DB_PATH=./data/sellitnow.db
# Optional: force SSL options for managed Postgres (defaults on when URL hints Render/AWS or sslmode=require).
# DATABASE_SSL=true
# Optional (development only): disable strict TLS validation for Postgres
# DATABASE_SSL_INSECURE=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
# Signed guest order access token expiry (used for guest order details/payment access)
GUEST_ORDER_TOKEN_EXPIRES_IN=7d
# Auth cookie settings
# AUTH_COOKIE_NAME=sellitnow_auth
# CSRF_COOKIE_NAME=sellitnow_csrf
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax

# Stripe (get keys from https://dashboard.stripe.com/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email (Nodemailer) — use your Microsoft 365 / SMTP provider for support@3nitylab.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@3nitylab.com
SMTP_PASS=your-app-password
EMAIL_FROM=3nityLab <support@3nitylab.com>
EMAIL_REPLY_TO=support@3nitylab.com
SUPPORT_EMAIL=support@3nitylab.com
BUSINESS_NAME=3nityLab

# Unpaid card orders are auto-cancelled (payment failed) after this many days (default 3).
# UNPAID_ORDER_EXPIRY_DAYS=3
# How often the server checks for expired orders in milliseconds (default 6 hours).
# UNPAID_ORDER_CHECK_INTERVAL_MS=21600000

# App
VAT_RATE=0.20
# Fallback when no default is saved in Admin → Settings → Delivery (brand_settings.defaultDeliveryCost)
SHIPPING_COST=5.99

# Cyprus pickup sync (checkout is pickup-only)
# Box Now + Akis Express sync automatically on startup / Admin → Pickup stores → Sync
# BOXNOW_CY_LOCATIONS_URL=https://locationapi-production.boxnow.cy/v1/apms_el-CY.json
# AKIS_STORES_URL=https://gapakisexpress.com/stores/
# Optional ACS merchant API credentials (required to list ACS Cyprus SmartPoints / shops)
# Optional: import ACS Cyprus shops from Excel when API credentials are unavailable.
# Default looks for data/acs-network-locations.xlsx or src/database/fixtures/acs-network-locations.xlsx
# ACS_NETWORK_XLSX=./data/acs-network-locations.xlsx

# Demo login values from the ACS PDF are company/user = demo, but ACS_API_KEY is issued privately by ACS.
# ACS_COMPANY_ID=demo
# ACS_COMPANY_PASSWORD=demo
# ACS_USER_ID=demo
# ACS_USER_PASSWORD=demo
# ACS_API_KEY=your-acs-api-key
# ACS_API_URL=https://webservices.acscourier.net/ACSRestServices/api/ACSAutoRest
# ACS_LANGUAGE=EN
# Cyprus shop kinds: 1=central, 4=shop-in-shop, 8=SmartPoint lockers
# ACS_SHOP_KINDS=1,4,8

# Storage root (Render persistent disk sets RENDER_DISK_ROOT automatically)
# STORAGE_ROOT=/var/data
# UPLOAD_DIR default: <STORAGE_ROOT>/uploads
UPLOAD_DIR=./uploads
# Public URL prefix to serve uploaded files
UPLOAD_URL_PREFIX=/uploads
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_PRODUCT=5
